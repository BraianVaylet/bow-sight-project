# ── Base de datos ─────────────────────────────────────────────────
# Atlas o local, SIEMPRE con replica set: sin el no hay transacciones.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=bow_sight_dev

# ── Auth (Better Auth) ────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Aplicacion ────────────────────────────────────────────────────
APP_ENV=dev
PORT=3000
# Origenes de la PWA y la landing, sin comodines.
CORS_ORIGINS=http://localhost:5173,http://localhost:5176
PWA_URL=http://localhost:5173
LANDING_URL=http://localhost:5176

# ── Email transaccional ───────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Bow Sight <no-reply@example.com>

# ── Cobro ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_MONTH=
STRIPE_PRICE_MAX_YEAR=

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PREAPPROVAL_PLAN_PRO=
MP_PREAPPROVAL_PLAN_MAX=

# ── Operacion ─────────────────────────────────────────────────────
JOBS_ENABLED=true
LOG_LEVEL=info
SENTRY_DSN=
GRACE_DAYS=7
