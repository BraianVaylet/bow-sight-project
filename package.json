{
  "name": "bow-sight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:sandbox": "tsx scripts/dev-sandbox.ts",
    "build": "turbo run build",
    "test": "turbo run test && vitest run --config vitest.scripts.config.ts",
    "test:coverage": "turbo run test:coverage && vitest run --config vitest.scripts.config.ts --coverage",
    "test:e2e": "playwright test",
    "lint": "turbo run lint && eslint scripts e2e \"*.config.{js,ts}\" eslint.config.js",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node scripts/check-links.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bow-sight/config": "workspace:*",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@hono/node-server": "^1.13.7",
    "@js-temporal/polyfill": "^0.5.1",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.17.0",
    "hono": "^4.13.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "migrate-mongo": "^11.0.0",
    "mongodb": "~6.20.0",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.24.4",
    "pino": "^9.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.23.13",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.0.0",
    "zod": "^4.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix --max-warnings=0"
  }
}
