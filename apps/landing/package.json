{
  "name": "@bow-sight/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsc --noEmit && vite-react-ssg build",
    "preview": "vite preview --outDir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@bow-sight/client": "workspace:*",
    "@bow-sight/domain": "workspace:*",
    "@bow-sight/types": "workspace:*",
    "@bow-sight/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6",
    "vite-react-ssg": "^0.8.9"
  },
  "devDependencies": {
    "@bow-sight/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.0.0"
  }
}
