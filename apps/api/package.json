    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@bow-sight/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.0",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
